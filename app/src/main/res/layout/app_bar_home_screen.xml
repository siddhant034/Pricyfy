<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.siddhant.pricyfy.homeScreen">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pricify_blue"
        android:theme="@style/AppTheme.AppBarOverlay"
        android:id="@+id/relativeLayout"
        android:clickable="true"
        android:gravity="start">

        <android.support.v7.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#ffffff"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:titleTextAppearance="@style/AppTheme"
            app:contentInsetStartWithNavigation="0dp"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/company_logo"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!--android.support.v7.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:background="#00ffff"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                android:layout_height="match_parent">
            </android.support.v7.widget.SearchView-->

        </android.support.v7.widget.Toolbar>

    </RelativeLayout>

    <include
        layout="@layout/content_home_screen"
        android:id="@+id/ccc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="0dp"
        android:layout_above="@+id/footer"
        android:layout_below="@+id/relativeLayout"
        android:layout_alignRight="@+id/relativeLayout"
        android:layout_alignEnd="@+id/relativeLayout"
        android:layout_alignLeft="@+id/relativeLayout"
        android:layout_alignStart="@+id/relativeLayout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#ffffff"
        android:theme="@style/AppTheme.AppBarOverlay"
        android:id="@+id/footer"
        android:clickable="true"
        android:orientation="horizontal"
        android:elevation="5dp"
        android:layout_alignParentBottom="true">

        <FrameLayout
            android:id="@+id/button_home_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:background="#ffffff"
                android:scaleType="center"
                android:tint="@color/pricify_blue"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/home_footer"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Home"
                android:gravity="bottom"
                android:textStyle="bold"
                android:textColor="@color/pure_black"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_deals_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:background="#ffffff"
                android:scaleType="center"
                android:tint="@color/pricify_blue"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/deals_footer"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Deals"
                android:gravity="bottom"
                android:textStyle="bold"
                android:textColor="@color/pure_black"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_coupons_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:background="#ffffff"
                android:scaleType="center"
                android:tint="@color/pricify_blue"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/coupons_footer"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Coupons"
                android:gravity="bottom"
                android:textColor="@color/pure_black"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_profile_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:background="#ffffff"
                android:scaleType="center"
                android:tint="@color/pricify_blue"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/profile_footer"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Profile"
                android:textColor="@color/pure_black"
                android:gravity="bottom"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
