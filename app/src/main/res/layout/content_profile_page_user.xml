<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".homeScreen"
    tools:ignore="contentDescription"
    android:background="@color/background_home_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_home_screen"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context="com.example.siddhant.pricyfy.homeScreen">

        <RelativeLayout
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/linear_layout1">

            <de.hdodenhof.circleimageview.CircleImageView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/profile_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:paddingLeft="10dp"
                android:src="@drawable/profile_pic_sidebar"
                app:civ_border_width="1dp"
                android:paddingTop="1dp"
                app:civ_border_color="#A9A9A9"
                android:layout_gravity="bottom"/>

            <LinearLayout
                android:id="@+id/ll2"
                android:paddingLeft="25dp"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/profile_image"
                android:background="@color/background_home_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="goToDealsPage">

                <TextView
                    android:id="@+id/tv1"
                    android:paddingLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello"
                    android:gravity="center_vertical"
                    android:textStyle="bold"
                    android:textColor="@color/pure_black"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No name"
                    android:paddingLeft="5dp"
                    android:id="@+id/tv2"
                    android:textStyle="bold"
                    android:textColor="@color/pure_black"
                    android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                    android:clickable="true"
                    android:onClick="goToLoginPage"/>
            </LinearLayout>

        </RelativeLayout>
        <TextView
            android:layout_width="match_parent"
            android:id="@+id/tv_signout"
            android:layout_height="wrap_content"
            android:layout_below="@id/linear_layout1"
            android:textAlignment="viewEnd"
            android:paddingRight="10dp"
            android:text="Logout"
            android:clickable="true"
            android:onClick="signOut"/>

            <RelativeLayout
                android:id="@+id/deals"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/tv_signout"
                android:layout_centerHorizontal="true">

                <LinearLayout
                    android:id="@+id/tvLL1"
                    android:clickable="true"
                    android:onClick="openDealsPage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#ffffff"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:text="Deals of the Day"
                        android:textAllCaps="false"
                        android:textSize="15dp"
                        android:textColor="@color/deals_of_the_day"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:text="View all"
                        android:gravity="end"
                        android:textAllCaps="false"
                        android:textAlignment="textEnd"
                        android:textSize="10dp"
                        android:textColor="@color/view_all"
                        android:textStyle="bold" />
                </LinearLayout>

                <android.support.v7.widget.RecyclerView
                    android:id="@+id/rv_deals"
                    android:layout_width="match_parent"
                    android:background="@color/background_home_screen"
                    android:layout_height="fill_parent"
                    android:layout_below="@id/tvLL1"
                    xmlns:android="http://schemas.android.com/apk/res/android">
                </android.support.v7.widget.RecyclerView>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/coupons"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:layout_below="@id/deals"
                android:layout_centerHorizontal="true">

                <LinearLayout
                    android:id="@+id/tvLL2"
                    android:clickable="true"
                    android:background="#ffffff"
                    android:onClick="openCouponsPage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:text="Coupons"
                        android:textAllCaps="false"
                        android:textSize="15dp"
                        android:textColor="@color/deals_of_the_day"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_weight="1"
                        android:layout_marginRight="5dp"
                        android:text="View all"
                        android:gravity="end"
                        android:textAllCaps="false"
                        android:textAlignment="textEnd"
                        android:textSize="10dp"
                        android:textColor="@color/view_all"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:background="@color/background_home_screen"
                    android:layout_below="@id/tvLL2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/coupon_ll1"
                            xmlns:android="http://schemas.android.com/apk/res/android"
                            android:layout_width="150dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="0dp"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/iv2_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:id="@+id/tv2_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="4"
                                android:textAlignment="center"
                                android:background="#ffffff"
                                android:textColor="#000000"
                                android:textSize="10dp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/coupon_ll2"
                            xmlns:android="http://schemas.android.com/apk/res/android"
                            android:layout_width="150dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="0dp"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/iv1_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:id="@+id/tv1_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="4"
                                android:textAlignment="center"
                                android:background="#ffffff"
                                android:textColor="#000000"
                                android:textSize="10dp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/coupon_ll3"
                            xmlns:android="http://schemas.android.com/apk/res/android"
                            android:layout_width="150dp"
                            android:layout_height="match_parent"
                            android:layout_margin="1dp"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="0dp"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/iv3_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:scaleType="fitXY"/>
                            <TextView
                                android:id="@+id/tv3_coupons"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="4"
                                android:background="#ffffff"
                                android:textAlignment="center"
                                android:textColor="#000000"
                                android:textSize="10dp"/>

                        </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:background="@color/background_home_screen"
                android:id="@+id/recently_viewed_products"
                android:layout_below="@id/coupons">


                <LinearLayout
                    android:id="@+id/tvLL3"
                    android:clickable="true"
                    android:onClick="setViewAllButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="1dp"
                    android:orientation="horizontal"
                    android:background="#ffffff">
                    <TextView
                        android:layout_gravity="center"
                        android:layout_width="500dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginLeft="5dp"
                        android:text="Recently Viewed Products"
                        android:textAllCaps="false"
                        android:textSize="15dp"
                        android:textColor="@color/deals_of_the_day"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="25dp"
                        android:layout_weight="1"
                        android:layout_marginRight="5dp"
                        android:textAlignment="viewEnd"
                        android:text="View all"
                        android:gravity="center"
                        android:textAllCaps="false"
                        android:textSize="10dp"
                        android:textColor="@color/view_all"
                        android:textStyle="bold" />
                </LinearLayout>

                <android.support.v7.widget.RecyclerView
                    android:background="@color/background_home_screen"
                    android:layout_below="@id/tvLL3"
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    xmlns:android="http://schemas.android.com/apk/res/android" />
            </RelativeLayout>
        <ProgressBar
            android:id="@+id/progressBar1"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:secondaryProgressTint="@color/pricify_blue"
            android:progressDrawable="@color/pricify_blue"
            android:progressTint="@color/pricify_blue"/>
    </RelativeLayout>
</ScrollView>