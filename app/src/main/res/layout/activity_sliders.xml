<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@color/black_overlay"
    android:id="@+id/rl_all_products"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/customborder1"
        android:theme="@style/AppTheme.AppBarOverlay"
        android:id="@+id/relativeLayout"
        android:clickable="true"
        android:gravity="start">

        <android.support.v7.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#ffffff"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:titleTextAppearance="@style/AppTheme"
            app:contentInsetStartWithNavigation="0dp"
            app:popupTheme="@style/AppTheme.PopupOverlay"
            android:layout_alignParentLeft="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_company_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>

        </android.support.v7.widget.Toolbar>

    </RelativeLayout>

    <include
        layout="@layout/content_sliders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relativeLayout"
        android:layout_above="@+id/footer"
        android:layout_alignRight="@+id/relativeLayout"
        android:layout_alignEnd="@+id/relativeLayout"
        android:layout_alignLeft="@+id/relativeLayout"
        android:layout_alignStart="@+id/relativeLayout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/footer_height"
        android:background="@drawable/customborder"
        android:id="@+id/footer"
        android:clickable="true"
        android:orientation="horizontal"
        android:elevation="5dp"
        android:layout_alignParentBottom="true">

        <FrameLayout
            android:id="@+id/button_home_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:onClick="goToHomePage">
            <ImageView
                android:id="@+id/iv_footer_home"
                android:background="#ffffff"
                android:scaleType="center"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/home_footer"/>
            <TextView
                android:id="@+id/tv_footer_home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Home"
                android:gravity="bottom"
                android:textSize="10dp"
                android:paddingTop="5dp"
                android:textStyle="bold"
                android:textColor="@color/footer_names"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_deals_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:onClick="goToDealsPage">
            <ImageView
                android:id="@+id/iv_footer_deals"
                android:background="#ffffff"
                android:scaleType="center"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/deals_footer"/>
            <TextView
                android:id="@+id/tv_footer_deals"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Deals"
                android:gravity="bottom"
                android:textSize="10dp"
                android:paddingTop="5dp"
                android:textStyle="bold"
                android:textColor="@color/footer_names"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_coupons_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:onClick="goToCouponsPage">
            <ImageView
                android:id="@+id/iv_footer_coupons"
                android:background="#ffffff"
                android:scaleType="center"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/coupons_footer"/>
            <TextView
                android:id="@+id/tv_footer_coupons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Coupons"
                android:gravity="bottom"
                android:textSize="10dp"
                android:paddingTop="5dp"
                android:textStyle="bold"
                android:textColor="@color/footer_names"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/button_profile_footer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:onClick="goToProfilePage">
            <ImageView
                android:id="@+id/iv_footer_profile"
                android:background="#ffffff"
                android:scaleType="center"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_height="match_parent"
                android:src="@mipmap/profile_footer"/>
            <TextView
                android:id="@+id/tv_footer_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Profile"
                android:gravity="bottom"
                android:textSize="10dp"
                android:paddingTop="5dp"
                android:textStyle="bold"
                android:textColor="@color/footer_names"
                android:textAlignment="center"
                android:textAllCaps="false"/>
        </FrameLayout>
    </LinearLayout>

    <!--ProgressBar
        android:id="@+id/progressBar1"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:secondaryProgressTint="@color/pricify_blue"
        android:progressDrawable="@color/pricify_blue"
        android:progressTint="@color/pricify_blue"/-->


</RelativeLayout>