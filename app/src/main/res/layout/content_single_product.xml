<?xml version="1.0" encoding="utf-8"?>

<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_product_name"
            android:layout_width="match_parent"
            android:paddingTop="10dp"
            android:paddingLeft="10dp"
            android:textStyle="bold"
            android:paddingRight="10dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16dp"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:gravity="left"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:background="#ffffff"
            android:layout_weight="3">

            <LinearLayout
                android:id="@+id/ll_rating"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                android:padding="2dp"
                android:background="@drawable/single_product_buttons"
                app:backgroundTint="@color/pricify_blue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible">

                <TextView
                    android:paddingLeft="5dp"
                    android:textSize="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/seller_ratings"
                    android:textColor="#ffffff"
                    android:paddingRight="2dp"/>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stepSize="0.1"
                    android:clickable="false"
                    android:isIndicator="true"
                    android:visibility="invisible"
                    android:progressTint="#ffffff"
                    android:secondaryProgressTint="#b2b2b2"
                    style="?android:attr/ratingBarStyleSmall"
                    android:numStars="1" />

            </LinearLayout>

            <TextView
                android:paddingLeft="5dp"
                android:textSize="10dp"
                android:paddingTop="2dp"
                android:layout_toRightOf="@id/ll_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/total_ratings"
                android:textColor="#000000" />

        </RelativeLayout>

        <ImageView
            android:layout_gravity="top"
            android:background="#ffffff"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:id="@+id/imageView_product"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:paddingBottom="10dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/hor_break1"
            android:layout_width="fill_parent"
            android:visibility="invisible"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@color/background_home_screen"/>

        <TextView
            android:id="@+id/textView_bestPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:textStyle="bold"
            android:textSize="15dp"
            android:textColor="#000000"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:id="@+id/ll_prices"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bestPriceIcon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:visibility="invisible"
                android:src="@drawable/flipkart">
            </ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_bestPrice2"
                    android:layout_width="100dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/textView_mrp"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10dp"
                    android:textAlignment="center"
                    android:textColor="#aaaaaa"/>
            </LinearLayout>
            <Button
                android:id="@+id/button_goToStorebestPrice"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:textAllCaps="false"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:background="@drawable/single_product_buttons"
                android:backgroundTint="@color/pricify_blue"
                android:visibility="invisible"/>
        </LinearLayout>

        <View
            android:layout_marginTop="10dp"
            android:layout_width="fill_parent"
            android:layout_height="10dp"
            android:background="@color/background_home_screen"/>

        <TextView
            android:paddingTop="5dp"
            android:textColor="#000000"
            android:textAllCaps="false"
            android:id="@+id/tv_key_features1"
            android:text="Features"
            android:textStyle="bold"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="15dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:paddingTop="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:id="@+id/tv_key_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_marginTop="10dp"
            android:layout_width="fill_parent"
            android:layout_height="10dp"
            android:background="@color/background_home_screen"/>



        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:layout_toRightOf="@id/ll_rating"
            android:visibility="invisible"
            android:id="@+id/grid"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/stock"
                    android:layout_width="wrap_content"
                    android:textColor="#000000"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:id="@+id/stock_tick"
                    android:layout_width="10dp"
                    android:layout_gravity="center"
                    android:layout_height="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/cod"
                    android:layout_width="wrap_content"
                    android:paddingLeft="10dp"
                    android:textColor="#000000"
                    android:layout_height="wrap_content" />
                <ImageView
                    android:id="@+id/cod_tick"
                    android:layout_width="10dp"
                    android:layout_gravity="center"
                    android:layout_height="10dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/delivery"
                android:layout_width="wrap_content"
                android:paddingLeft="10dp"
                android:textColor="#000000"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/shipping_charge"
                android:layout_width="wrap_content"
                android:paddingLeft="10dp"
                android:layout_height="wrap_content"
                android:textColor="#000000" />

        </LinearLayout>

        <View
            android:layout_marginTop="10dp"
            android:layout_width="fill_parent"
            android:layout_height="10dp"
            android:background="@color/background_home_screen"/>

        <TextView
            android:id="@+id/textViewComparePrices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:textAllCaps="false"
            android:background="#ffffff"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:id="@+id/ll_flipkart"
            android:visibility="invisible"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/flipkart_icon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:src="@drawable/flipkart"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/flipkart_best_price"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="NA"
                    android:gravity="center"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:textColor="#ffffff"
                android:text="Go To Store"
                android:textAllCaps="false"
                android:background="@drawable/single_product_buttons"
                android:backgroundTint="@color/pricify_blue"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/ll_amazon"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/amazon_icon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:src="@drawable/amazon"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/amazon_best_price"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="NA"
                    android:textSize="15dp"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pricify_blue"
                android:textColor="#ffffff"
                android:text="Go To Store"
                android:textAllCaps="false"
                android:background="@drawable/single_product_buttons" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_ebay"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ebay_icon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:src="@drawable/ebay"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/ebay_best_price"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="NA"
                    android:gravity="center"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pricify_blue"
                android:textColor="#ffffff"
                android:text="Go To Store"
                android:textAllCaps="false"
                android:background="@drawable/single_product_buttons" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_paytm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/_icon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:src="@drawable/paytm"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/paytm_best_price"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="NA"
                    android:gravity="center"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pricify_blue"
                android:textColor="#ffffff"
                android:text="Go To Store"
                android:textAllCaps="false"
                android:background="@drawable/single_product_buttons" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_infibeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:layout_weight="1"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="10dp"
            android:background="#ffffff"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/infibeam_icon"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="left"
                android:layout_weight="1"
                android:src="@drawable/infibeam"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/infibeam_best_price"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="NA"
                    android:gravity="center"
                    android:textSize="15dp"
                    android:layout_weight="1"
                    android:textColor="#000000"/>
            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pricify_blue"
                android:textColor="#ffffff"
                android:text="Go To Store"
                android:textAllCaps="false"
                android:background="@drawable/single_product_buttons" />
        </LinearLayout>


        <View
            android:layout_marginTop="10dp"
            android:layout_width="fill_parent"
            android:layout_height="10dp"
            android:background="@color/background_home_screen"/>


        <TextView
            android:id="@+id/desc1"
            android:layout_width="match_parent"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:layout_margin="2dp"
            android:background="#ffffff"
            android:paddingLeft="10dp"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/desc2"
            android:layout_width="match_parent"
            android:textSize="11dp"
            android:background="#ffffff"
            android:paddingBottom="5dp"
            android:layout_margin="2dp"
            android:paddingLeft="10dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

</ScrollView>