<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_home_screen"
    android:id="@+id/ll_all_products2">

<android.support.v7.widget.CardView android:id="@+id/cardview_allProducts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="1dp"
    android:clickable="true"
    card_view:cardElevation="1dp"
    card_view:cardCornerRadius="1dp"
    android:background="@color/background_home_screen"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto">

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="150dp"
    android:padding="1dp"
    android:layout_gravity="center"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <ImageView
        android:id="@+id/image_view_deals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:padding="5dp"
        android:background="#ffffff"
        android:scaleType="fitCenter"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:textColor="#000000"
        android:textSize="10dp"
        android:textAlignment="center"
        android:id="@+id/text_view_deals"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:textColor="#228B22"
        android:textSize="12dp"
        android:text="BEST DEAL"
        android:textAlignment="center"
        android:id="@+id/best_deal_tv"/>

</LinearLayout>
</android.support.v7.widget.CardView>
</LinearLayout>