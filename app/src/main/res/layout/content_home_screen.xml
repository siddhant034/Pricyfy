<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".homeScreen"
    tools:ignore="contentDescription"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context="com.example.siddhant.pricyfy.homeScreen">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:id="@+id/viewPagerFrameLayout">
            <android.support.v4.view.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="0dp"
                android:clickable="true"
                android:paddingBottom="0dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            </android.support.v4.view.ViewPager>

            <me.relex.circleindicator.CircleIndicator
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="bottom"
                />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="100dp"
            android:baselineAligned="false"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/viewPagerFrameLayout"
            android:layout_marginTop="0dp"
            android:id="@+id/relativeLayout1">

            <LinearLayout
                android:id="@+id/button_deals"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openDealsPage">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/deals"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/deals"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobiles"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/mobiles_tablets"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/mobiles_and_tablets"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/laptops"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openDealsPage">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/laptops_peripherals"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/laptops_and_peripherals"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cameras"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/camera_accessories"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/mobiles_and_tablets"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="100dp"
            android:baselineAligned="false"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/relativeLayout1"
            android:layout_marginTop="0dp"
            android:id="@+id/relativeLayout2">

            <LinearLayout
                android:id="@+id/tv"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/tv_entertainment"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/tv_and_entertainment"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/men"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/men"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/men"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/women"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/women"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/women"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/other"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="2dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/other"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="Other Products"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="#000000"
                    android:textSize="8dp" />
            </LinearLayout>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/deals"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/relativeLayout2"
            android:layout_margin="2dp"
            android:layout_marginTop="2dp"
            android:layout_centerHorizontal="true">


            <Button
                android:id="@+id/button"
                android:backgroundTint="@color/pricify_blue"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:textColor="#112233"
                android:text="Deals of the day"
                android:layout_margin="2dp"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:background="#ffffff"
                android:elevation="0dp"
                android:textSize="15dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_deals"
                android:elevation="5dp"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_below="@id/button"
                android:layout_alignParentBottom="true"
                xmlns:android="http://schemas.android.com/apk/res/android">
            </android.support.v7.widget.RecyclerView>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/coupons"
            android:layout_margin="2dp"
            android:layout_below="@+id/deals">

            <Button
                android:id="@+id/dealandOffers"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Coupons"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:layout_below="@id/dealandOffers">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv2_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="1dp"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv2_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:textAlignment="center"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv1_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="1dp"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv1_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:textAlignment="center"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv3_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:padding="1dp"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv3_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="3"
                            android:textAlignment="center"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout"
            android:layout_margin="2dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@+id/coupons">
        </ImageView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="2dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/mobile_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_relative_layout">

            <Button
                android:id="@+id/mobile_ranges_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Desired Range of Mobile Phones"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp"
                android:onClick="openAllProducts"/>

            <android.support.v7.widget.RecyclerView
                android:elevation="5dp"
                android:layout_below="@id/mobile_ranges_button"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_alignParentBottom="true"
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/rv_mobiles"
                android:layout_margin="2dp"
                />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_margin="2dp"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/camera_ranges_relative_layout"
            android:layout_below="@+id/mobile_ranges_relative_layout">

            <Button
                android:id="@+id/camera_ranges_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Desired Range of Cameras"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp"
                android:onClick="openAllProducts"/>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_cameras"
                android:layout_width="match_parent"
                android:layout_margin="2dp"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout1"
            android:layout_width="match_parent"
            android:layout_margin="2dp"
            android:layout_height="150dp"
            android:layout_below="@+id/camera_ranges_relative_layout"
            android:clickable="true"
            android:scaleType="fitXY"
            android:onClick="openAdBanner1">
        </ImageView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="2dp"
            android:orientation="horizontal"
            android:id="@+id/ad_banner_linear_layout1"
            android:layout_below="@id/ad_banner_relative_layout1">
            <ImageView
                android:id="@+id/ad_banner_relative_layout2"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:layout_margin="2dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout3"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_margin="2dp"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout4"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="2dp"
            android:scaleType="fitXY"
            android:layout_below="@+id/ad_banner_linear_layout1"
            android:clickable="true"
            android:onClick="openAdBanner1">
        </ImageView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_margin="2dp"
            android:layout_alignParentStart="true"
            android:id="@+id/men_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_relative_layout4">

            <Button
                android:id="@+id/men_ranges_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Desired Range of Men's Clothing"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp"
                android:onClick="openAllProducts"/>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_men"
                android:layout_width="match_parent"
                android:layout_margin="2dp"
                android:layout_below="@id/men_ranges_button"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:layout_margin="1dp"
            android:id="@+id/ad_banner_linear_layout2"
            android:layout_below="@id/men_ranges_relative_layout">
            <ImageView
                android:id="@+id/ad_banner_relative_layout5"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:scaleType="fitXY"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout6"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_margin="2dp"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout7"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="150dp"
            android:layout_margin="2dp"
            android:clickable="true"
            android:scaleType="fitXY"
            android:layout_below="@id/ad_banner_linear_layout2"
            android:onClick="openAdBanner1">
        </ImageView>

        <ImageView
            android:id="@+id/ad_banner_relative_layout8"
            android:layout_below="@id/ad_banner_relative_layout7"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="fitXY"
            android:layout_height="150dp"
            android:clickable="true"
            android:onClick="openAdBanner1">
        </ImageView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_margin="2dp"
            android:layout_alignParentStart="true"
            android:id="@+id/women_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_relative_layout8">

            <Button
                android:id="@+id/women_ranges_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Desired Range of Women's Clothing"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp"
                android:onClick="openAllProducts"/>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_women"
                android:layout_width="match_parent"
                android:layout_margin="2dp"
                android:layout_below="@id/women_ranges_button"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout9"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="fitXY"
            android:layout_height="150dp"
            android:layout_below="@id/women_ranges_relative_layout"
            android:clickable="true"
            android:onClick="openAdBanner1"/>

        <ImageView
            android:id="@+id/ad_banner_relative_layout10"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:scaleType="fitXY"
            android:layout_height="150dp"
            android:layout_below="@id/ad_banner_relative_layout9"
            android:clickable="true"
            android:onClick="openAdBanner1">
        </ImageView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:layout_margin="2dp"
            android:id="@+id/ad_banner_linear_layout3"
            android:layout_below="@+id/ad_banner_relative_layout10">
            <ImageView
                android:id="@+id/ad_banner_relative_layout11"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout12"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:layout_margin="2dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_margin="2dp"
            android:layout_alignParentStart="true"
            android:id="@+id/footwear_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_linear_layout3">

            <Button
                android:id="@+id/footwear_ranges_button"
                android:layout_width="wrap_content"
                android:backgroundTint="@color/pricify_blue"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Desired Range of Women's Footwear"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="15dp"
                android:onClick="openAllProducts"/>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_footwear"
                android:layout_width="match_parent"
                android:layout_margin="2dp"
                android:layout_below="@id/footwear_ranges_button"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:layout_margin="2dp"
            android:id="@+id/ad_banner_linear_layout4"
            android:layout_below="@id/footwear_ranges_relative_layout">
            <ImageView
                android:id="@+id/ad_banner_relative_layout13"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout14"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>
        
    </RelativeLayout>

</ScrollView>