<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".homeScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context="com.example.siddhant.pricyfy.homeScreen">


        <android.support.v4.view.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_marginBottom="0dp"
            android:clickable="true"
            android:paddingBottom="0dp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </android.support.v4.view.ViewPager>

        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/view_pager"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="0dp"
            android:paddingTop="0dp"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintLeft_toRightOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />



        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="100dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/layoutDots"
            android:layout_marginTop="0dp"
            android:id="@+id/relativeLayout1">


            <ImageButton
                android:id="@+id/button_deals"
                android:layout_width="75dp"
                android:layout_height="99dp"
                android:layout_weight="1"
                android:layout_alignParentTop="true"
                android:layout_margin="1dp"
                android:layout_toRightOf="@+id/cameras"
                android:background="#ffffff"
                android:onClick="openDealsPage"
                android:src="@drawable/deals"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                />


            <ImageButton
                android:id="@+id/mobiles"
                android:layout_width="75dp"
                android:layout_weight="1"
                android:layout_height="99dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                android:layout_margin="1dp"
                android:layout_toRightOf="@+id/dealandOffers"
                android:background="#ffffff"
                android:src="@drawable/mobiles_tablets"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:onClick="openAllProducts"
                />

            <ImageButton
                android:id="@+id/laptops"
                android:layout_width="75dp"
                android:layout_weight="1"
                android:layout_height="99dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_margin="1dp"
                android:background="#ffffff"
                android:src="@drawable/laptops_peripherals"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:onClick="openAllProducts"
                />

            <ImageButton
                android:id="@+id/cameras"
                android:layout_width="75dp"
                android:layout_weight="1"
                android:layout_height="99dp"
                android:layout_alignParentTop="true"
                android:layout_margin="1dp"
                android:layout_toRightOf="@+id/laptops"
                android:background="#ffffff"
                android:src="@drawable/camera_accessories"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:onClick="openAllProducts"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="24dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/relativeLayout1"
            android:layout_marginTop="0dp"
            android:background="#ffffff"
            android:layout_margin="1dp"
            android:id="@+id/relativeLayout2"
            >

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Deals"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"
                />

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Mobiles and Tablets"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Laptops and Accessories"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Cameras"
                android:textAlignment="center"
                android:textSize="10dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/linearLayout3"
            android:layout_height="100dp"
            android:layout_marginTop="0dp"
            android:layout_below="@id/relativeLayout2">

            <ImageButton
                android:id="@+id/tv"
                android:layout_width="75dp"
                android:layout_height="99dp"
                android:layout_weight="1"
                android:layout_alignParentBottom="true"
                android:layout_alignParentLeft="true"
                android:layout_margin="1dp"
                android:background="#ffffff"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/tv_entertainment"
                android:layout_below="@id/laptops"
                android:onClick="openAllProducts"
                />

            <ImageButton
                android:id="@+id/men"
                android:layout_width="75dp"
                android:layout_height="99dp"
                android:layout_weight="1"
                android:background="#ffffff"
                android:src="@drawable/men"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_margin="1dp"
                android:layout_below="@+id/cameras"
                android:layout_toRightOf="@id/tv"
                android:layout_alignParentBottom="true"
                android:onClick="openAllProducts"
                />



            <ImageButton
                android:id="@+id/women"
                android:layout_width="75dp"
                android:layout_height="99dp"
                android:layout_weight="1"
                android:layout_alignParentBottom="true"
                android:layout_margin="1dp"
                android:layout_toRightOf="@+id/others"
                android:background="#ffffff"
                android:src="@drawable/women"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_below="@id/mobiles"
                android:onClick="openAllProducts"
                />

            <ImageButton
                android:id="@+id/others"
                android:layout_width="75dp"
                android:layout_height="99dp"
                android:layout_weight="1"
                android:layout_alignParentBottom="true"
                android:layout_margin="1dp"
                android:layout_below="@id/dealandOffers"
                android:layout_toRightOf="@+id/men"
                android:background="#ffffff"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/other"
                android:onClick="openAllProducts"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="24dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/linearLayout3"
            android:layout_marginTop="0dp"
            android:background="#ffffff"
            android:layout_margin="1dp"
            android:id="@+id/relativeLayout4">

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="TV and Entertainment"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Men"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Women"
                android:textSize="10dp"
                android:textAlignment="center"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="75dp"
                android:layout_height="24dp"
                android:text="Other products"
                android:textAlignment="center"
                android:textSize="10dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/deals"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/relativeLayout4"
            android:layout_margin="1dp"
            android:layout_marginTop="2dp"
            android:layout_centerHorizontal="true">


            <Button
                android:id="@+id/button"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="true"
                android:textColor="#112233"
                android:text="Deals of the day"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:background="#ffffff"
                android:elevation="0dp"
                android:textSize="20dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:layout_below="@id/button"
                android:id="@+id/horizontalScrollView">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                    
                   <Button
                       android:layout_width="120dp"
                       android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="fill_parent" />

                </LinearLayout>
            </HorizontalScrollView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/ad"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/deals">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/coupons"
            android:layout_below="@+id/ad">

            <Button
                android:id="@+id/dealandOffers"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="#ffffff"
                android:elevation="0dp"
                android:gravity="start"
                android:text="Coupons"
                android:textAlignment="viewStart"
                android:textColor="#112233"
                android:textSize="20dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:layout_below="@id/dealandOffers">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">
                        <Button
                            android:layout_width="240dp"
                            android:layout_height="fill_parent" />

                        <Button
                            android:layout_width="240dp"
                            android:layout_height="fill_parent" />

                        <Button
                            android:layout_width="240dp"
                            android:layout_height="fill_parent" />
                </LinearLayout>
            </HorizontalScrollView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/men499"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/coupons">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/women499"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/men499">

            <ImageButton
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

    </RelativeLayout>

</ScrollView>