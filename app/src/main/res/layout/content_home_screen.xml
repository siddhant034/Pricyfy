<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".homeScreen"
    tools:ignore="contentDescription"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context="com.example.siddhant.pricyfy.homeScreen">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:id="@+id/viewPagerFrameLayout">
            <android.support.v4.view.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="0dp"
                android:clickable="true"
                android:paddingBottom="0dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            </android.support.v4.view.ViewPager>

            <me.relex.circleindicator.CircleIndicator
                android:id="@+id/indicator"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="bottom"
                />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="90dp"
            android:baselineAligned="false"
            android:background="@color/background_home_screen"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/viewPagerFrameLayout"
            android:id="@+id/relativeLayout1">

            <LinearLayout
                android:id="@+id/button_deals"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openDealsPage">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/hot_deals"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="Hot deals"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobiles"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/mobiles"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="Mobiles"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/laptops"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openDealsPage">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/smartwatches"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="Smartwatches"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cameras"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/cameras"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="Cameras"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="90dp"
            android:baselineAligned="false"
            android:background="@color/background_home_screen"
            android:layout_margin="0.5dp"
            android:layout_marginRight="0dp"
            android:layout_marginLeft="0dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/relativeLayout1"
            android:id="@+id/relativeLayout2">

            <LinearLayout
                android:id="@+id/tv"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/furnitures"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="Furnitures"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/men"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/mens_clothing"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="Men's clothing"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/women"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/mens_accessories"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="Men's accessories"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/other"
                android:background="#ffffff"
                android:layout_width="match_parent"
                android:padding="1dp"
                android:layout_weight="1"
                android:layout_margin="0.5dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clickable="true"
                android:onClick="openAllProducts">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:src="@drawable/womens_clothing"
                    android:scaleType="fitXY"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:text="Women's clothing"
                    android:layout_weight="4"
                    android:textAlignment="center"
                    android:textColor="@color/pure_black"
                    android:textSize="8dp" />
            </LinearLayout>


        </LinearLayout>

        <RelativeLayout
            android:id="@+id/deals"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/relativeLayout2"
            android:layout_centerHorizontal="true">


            <LinearLayout
                android:id="@+id/tvLL1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Deals of the day"
                    android:textAllCaps="false"
                    android:textSize="15dp"
                    android:textColor="@color/deals_of_the_day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="View all"
                    android:gravity="end"
                    android:textAllCaps="false"
                    android:textAlignment="textEnd"
                    android:textSize="10dp"
                    android:textColor="@color/view_all"
                    android:textStyle="bold" />
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_deals"
                android:layout_width="match_parent"
                android:background="@color/background_home_screen"
                android:layout_height="fill_parent"
                android:layout_below="@id/tvLL1"
                xmlns:android="http://schemas.android.com/apk/res/android">
            </android.support.v7.widget.RecyclerView>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/coupons"
            android:layout_margin="0.5dp"
            android:layout_below="@+id/deals">

            <LinearLayout
                android:id="@+id/tvLL2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0.5dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Coupons"
                    android:textAllCaps="false"
                    android:textSize="15dp"
                    android:textColor="@color/deals_of_the_day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="View all"
                    android:gravity="end"
                    android:textAllCaps="false"
                    android:textAlignment="textEnd"
                    android:textSize="10dp"
                    android:textColor="@color/view_all"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:background="@color/background_home_screen"
                android:layout_below="@id/tvLL2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="0.5dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv2_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv2_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:textAlignment="center"
                            android:background="#ffffff"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="0.5dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv1_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv1_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:textAlignment="center"
                            android:background="#ffffff"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>

                    <LinearLayout
                        xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="0.5dp"
                        android:layout_marginLeft="0dp"
                        android:layout_marginRight="0dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/iv3_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:src="@drawable/deals"
                            android:scaleType="fitXY"/>
                        <TextView
                            android:id="@+id/tv3_coupons"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_weight="5"
                            android:background="#ffffff"
                            android:textAlignment="center"
                            android:textColor="#000000"
                            android:textSize="10dp"/>

                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout"
            android:layout_margin="0.5dp"
            android:scaleType="fitXY"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:background="@color/background_home_screen"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_below="@+id/coupons">
        </ImageView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/mobile_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_relative_layout">


            <LinearLayout
                android:id="@+id/tvLL3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0.5dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="500dp"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Desired range of mobile phones"
                    android:textAllCaps="false"
                    android:singleLine="true"
                    android:textSize="15dp"
                    android:textColor="@color/deals_of_the_day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="View all"
                    android:gravity="end"
                    android:textAllCaps="false"
                    android:textAlignment="textEnd"
                    android:textSize="10dp"
                    android:textColor="@color/view_all"
                    android:textStyle="bold" />
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:elevation="5dp"
                android:background="@color/background_home_screen"
                android:layout_below="@id/tvLL3"
                android:layout_width="match_parent"
                android:layout_height="fill_parent"
                android:layout_alignParentBottom="true"
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/rv_mobiles"
                />
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:id="@+id/camera_ranges_relative_layout"
            android:layout_below="@+id/mobile_ranges_relative_layout">

            <LinearLayout
                android:id="@+id/tvLL4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0.5dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="500dp"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Desired range of cameras"
                    android:textAllCaps="false"
                    android:singleLine="true"
                    android:textSize="15dp"
                    android:textColor="@color/deals_of_the_day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="View all"
                    android:gravity="end"
                    android:textAllCaps="false"
                    android:textAlignment="textEnd"
                    android:textSize="10dp"
                    android:textColor="@color/view_all"
                    android:textStyle="bold" />
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_cameras"
                android:layout_width="match_parent"
                android:background="@color/background_home_screen"
                android:layout_below="@id/tvLL4"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout1"
            android:layout_width="match_parent"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_height="150dp"
            android:padding="1dp"
            android:background="@color/background_home_screen"
            android:layout_below="@+id/camera_ranges_relative_layout"
            android:clickable="true"
            android:scaleType="fitXY"
            android:onClick="openAdBanner1">
        </ImageView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:orientation="horizontal"
            android:background="@color/background_home_screen"
            android:padding="1dp"
            android:id="@+id/ad_banner_linear_layout1"
            android:layout_below="@id/ad_banner_relative_layout1">
            <ImageView
                android:id="@+id/ad_banner_relative_layout2"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_height="150dp"
                android:layout_margin="0.5dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout3"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_margin="0.5dp"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout4"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:padding="1dp"
            android:background="@color/background_home_screen"
            android:scaleType="fitXY"
            android:layout_below="@+id/ad_banner_linear_layout1"
            android:clickable="true"
            android:onClick="openAdBanner1">
        </ImageView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_alignParentLeft="true"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_alignParentStart="true"
            android:id="@+id/men_ranges_relative_layout"
            android:layout_below="@+id/ad_banner_relative_layout4">

            <LinearLayout
                android:id="@+id/tvLL5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="500dp"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="Desired range of men's clothing"
                    android:textAllCaps="false"
                    android:singleLine="true"
                    android:textSize="15dp"
                    android:textColor="@color/deals_of_the_day"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:layout_weight="1"
                    android:text="View all"
                    android:gravity="end"
                    android:textAllCaps="false"
                    android:textAlignment="textEnd"
                    android:textSize="10dp"
                    android:textColor="@color/view_all"
                    android:textStyle="bold" />
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_men"
                android:layout_width="match_parent"
                android:background="@color/background_home_screen"
                android:layout_below="@id/tvLL5"
                android:layout_height="200dp"
                xmlns:android="http://schemas.android.com/apk/res/android"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:layout_margin="0.5dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:background="@color/background_home_screen"
            android:padding="1dp"
            android:id="@+id/ad_banner_linear_layout2"
            android:layout_below="@id/men_ranges_relative_layout">
            <ImageView
                android:id="@+id/ad_banner_relative_layout5"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_margin="0.5dp"
                android:scaleType="fitXY"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>

            <ImageView
                android:id="@+id/ad_banner_relative_layout6"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:scaleType="fitXY"
                android:layout_margin="0.5dp"
                android:layout_height="150dp"
                android:clickable="true"
                android:onClick="openAdBanner1">
            </ImageView>
        </LinearLayout>

        <ImageView
            android:id="@+id/ad_banner_relative_layout7"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="150dp"
            android:padding="1dp"
